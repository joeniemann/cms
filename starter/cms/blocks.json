  "siteSettings": {
    "business": "Business Info: name, one-line description, address, directions note, phone, email, hours, social links, booking link, map label",
    "menu": "Menu: page order, Show in menu switch, menu word, header button",
    "callBand": "Call band: big words, paragraph, two buttons. Per page switch: showCallBand",
    "footer": "Footer: news sign-up heading, blurb, placeholder, button words, thank-you message"
  },
  "siteForms": {
    "business": {
      "title": "Business info",
      "lead": "This is the information that shows up all over the site: the footer, the Contact page, the map, and every Call us button. Change it here once and it updates everywhere.",
      "preview": "contact",
      "groups": [
        {
          "name": "The business",
          "fields": {
            "name": {
              "label": "Full business name",
              "kind": "text",
              "max": 60
            },
            "shortName": {
              "label": "Short name",
              "kind": "text",
              "max": 12,
              "note": "Used in small spaces, like \"YBN\"."
            },
            "description": {
              "label": "One-line description",
              "kind": "paragraph",
              "max": 120,
              "note": "Shows in the footer under the logo."
            },
            "legalLine": {
              "label": "Line at the very bottom of every page",
              "kind": "text",
              "max": 60
            }
          }
        },
        {
          "name": "Address",
          "fields": {
            "street": {
              "label": "Street address",
              "kind": "text",
              "max": 60
            },
            "cityLine": {
              "label": "City, state and zip",
              "kind": "text",
              "max": 40
            },
            "directionsNote": {
              "label": "Directions note",
              "kind": "text",
              "max": 80,
              "note": "Shows under the address on the Contact page, like \"Off Ustler Road\"."
            },
            "mapLabel": {
              "label": "Short address shown under the map",
              "kind": "text",
              "max": 60
            }
          }
        },
        {
          "name": "Phone and email",
          "fields": {
            "phone": {
              "label": "Phone number",
              "kind": "text",
              "max": 14,
              "pattern": "^\\(?\\d{3}\\)?[-. ]?\\d{3}[-. ]?\\d{4}$",
              "patternMessage": "Please enter a 10 digit phone number, like 352-536-2628. It is not saved until it looks right.",
              "note": "Every \"Call us\" button on the site uses this number."
            },
            "email": {
              "label": "Email address",
              "kind": "text",
              "max": 80,
              "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
              "patternMessage": "That does not look like an email address yet. It is not saved until it does."
            }
          }
        },
        {
          "name": "Shop hours",
          "fields": {
            "hours": {
              "label": "Hours",
              "kind": "list",
              "min": 1,
              "max": 4,
              "item": {
                "days": {
                  "label": "Days",
                  "kind": "text",
                  "max": 16
                },
                "times": {
                  "label": "Hours",
                  "kind": "text",
                  "max": 24
                }
              }
            }
          }
        },
        {
          "name": "Social links",
          "fields": {
            "social": {
              "label": "Social links",
              "kind": "object",
              "item": {
                "facebook": {
                  "label": "Facebook page address",
                  "kind": "text",
                  "max": 120,
                  "pattern": "^(https?://.*)?$",
                  "patternMessage": "The address needs to start with https://. Leave it empty to hide the icon."
                },
                "instagram": {
                  "label": "Instagram page address",
                  "kind": "text",
                  "max": 120,
                  "pattern": "^(https?://.*)?$",
                  "patternMessage": "The address needs to start with https://. Leave it empty to hide the icon."
                },
                "tiktok": {
                  "label": "TikTok page address",
                  "kind": "text",
                  "max": 120,
                  "pattern": "^(https?://.*)?$",
                  "patternMessage": "The address needs to start with https://. Leave it empty to hide the icon."
                }
              }
            }
          }
        },
        {
          "name": "Online booking",
          "fields": {
            "bookingLink": {
              "label": "Online booking link (optional)",
              "kind": "text",
              "max": 160,
              "pattern": "^(https?://.*)?$",
              "patternMessage": "The address needs to start with https://. Leave it empty if you do not use one.",
              "note": "Leave empty if you do not use an online booking page."
            }
          }
        }
      ]
    },
    "callBand": {
      "title": "Call band",
      "lead": "This is the big band near the bottom of most pages that invites people to call or message the shop. Change the words and where each button goes. To hide it on one page, use the switch at the bottom of that page's screen.",
      "preview": "home",
      "previewScroll": "end",
      "groups": [
        {
          "name": "The words",
          "fields": {
            "headline": {
              "label": "Big words",
              "kind": "text",
              "max": 30,
              "note": "Keep it short. It shows in large letters."
            },
            "text": {
              "label": "Sentence under the big words",
              "kind": "paragraph",
              "max": 200
            }
          }
        },
        {
          "name": "First button",
          "fields": {
            "primary": {
              "label": "First button",
              "kind": "object",
              "item": {
                "show": {
                  "label": "Show this button",
                  "kind": "switch",
                  "note": "Switch off to hide it. You can show both buttons, just one, or neither."
                },
                "label": {
                  "label": "Words on the button",
                  "kind": "text",
                  "max": 20
                },
                "link": {
                  "label": "Button goes to",
                  "kind": "link"
                },
                "style": {
                  "label": "Look",
                  "kind": "choice",
                  "options": [
                    [
                      "sewn",
                      "Orange"
                    ],
                    [
                      "heat",
                      "Glass"
                    ],
                    [
                      "line",
                      "Outline"
                    ]
                  ]
                }
              }
            }
          }
        },
        {
          "name": "Second button",
          "fields": {
            "secondary": {
              "label": "Second button",
              "kind": "object",
              "item": {
                "show": {
